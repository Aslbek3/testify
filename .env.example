DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Local Postgres (VPS production): DIRECT_URL can be identical to DATABASE_URL.
# Neon (or other pooled providers): DIRECT_URL must be the unpooled connection,
# used only for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
# To'lov cheklari saqlanadigan papka (ixtiyoriy). Berilmasa:
# <loyiha>/storage/receipts. Ochiq `public/` ichida BO'LMASLIGI shart.
# RECEIPTS_DIR="/root/vps/projects/web/testify/storage/receipts"
