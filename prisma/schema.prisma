generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  DIRECTOR
  TUTOR
  STUDENT
}

enum Plan {
  START
  STANDARD
  PRO
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  EXPIRED
}

enum AttemptMode {
  PRACTICE
  EXAM
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  city      String
  plan      Plan               @default(STANDARD)
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now())

  users  User[]
  groups Group[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String?
  role           Role
  organizationId String?
  createdAt      DateTime @default(now())

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  tutorOfGroups  Group[]         @relation("GroupTutor")
  studentProfile StudentProfile?
  attempts       Attempt[]

  @@index([organizationId])
}

model Group {
  id             String @id @default(cuid())
  name           String
  tutorId        String
  organizationId String

  tutor        User             @relation("GroupTutor", fields: [tutorId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  students     StudentProfile[]
  attempts     Attempt[]

  @@index([organizationId])
  @@index([tutorId])
}

model StudentProfile {
  id      String @id @default(cuid())
  userId  String @unique
  groupId String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Topic {
  id   String @id @default(cuid())
  name String

  questions Question[]
}

model Question {
  id                 String  @id @default(cuid())
  topicId            String
  text               String
  options            Json
  correctOptionIndex Int
  imageUrl           String?
  explanation        String?
  category           String?

  topic   Topic           @relation(fields: [topicId], references: [id])
  answers AttemptAnswer[]

  @@index([topicId])
}

model Attempt {
  id          String      @id @default(cuid())
  studentId   String
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  score       Int?
  mode        AttemptMode @default(PRACTICE)
  groupId     String?
  // Boshlanishda tanlangan savollar ID'lari, tartibi bilan — shu orqali
  // finishAttempt "jami savollar soni"ni biladi (javobsiz qolganlar ham
  // hisobga olinishi uchun) va kelajakda urinishni davom ettirish mumkin.
  questionIds String[]    @default([])

  student User            @relation(fields: [studentId], references: [id])
  group   Group?          @relation(fields: [groupId], references: [id])
  answers AttemptAnswer[]

  @@index([studentId])
  @@index([groupId])
}

model AttemptAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  questionId          String
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  // Bitta urinishda bitta savolga faqat bitta javob — qayta bosilsa
  // (masalan "Orqaga" bilan qaytib) yangilanadi, takrorlanmaydi.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
