generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  DIRECTOR
  TUTOR
  STUDENT
}

enum Plan {
  START
  STANDARD
  PRO
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  EXPIRED
}

enum AttemptMode {
  PRACTICE
  EXAM
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  city      String
  plan      Plan               @default(STANDARD)
  status    OrganizationStatus @default(TRIAL)
  createdAt DateTime           @default(now())
  // Obuna qachongacha amal qiladi. `null` — muddat belgilanmagan
  // (masalan sinov davri yoki eski tashkilot): bunda faqat `status`
  // ishlaydi, avvalgidek.
  //
  // Nega kerak: ilgari tashkilot bir marta "Faol" qilingach ABADIY faol
  // qolardi — hech narsa o'z-o'zidan tugamasdi va kimdir kalendarga
  // qarab qo'lda o'chirishi kerak edi.
  subscriptionEndsAt DateTime?

  users    User[]
  groups   Group[]
  payments Payment[]
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/**
 * To'lov haqida xabar.
 *
 * MVP'da to'lov tizimi bilan integratsiya yo'q: direktor to'lovni amalga
 * oshirgach uning raqamini shu yerga kiritadi, owner esa bank ko'chirmasi
 * bilan solishtirib tasdiqlaydi. Avtomatik to'lov keyinroq qo'shiladi —
 * o'shanda ham model o'zgarmaydi, faqat yozuvni direktor emas, to'lov
 * tizimining xabari yaratadi.
 */
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  /** So'mda, butun son — tiyin ishlatilmaydi. */
  amount         Int
  /** Necha oyga to'langan: 1, 6, 12 va h.k. */
  months         Int
  /** Qaysi tarif uchun — tasdiqlanganda tashkilot tarifi shunga o'tadi. */
  plan           Plan
  status         PaymentStatus @default(PENDING)
  /** Bank/to'lov tizimidagi tranzaksiya yoki kvitansiya raqami. */
  reference      String?
  note           String?
  createdAt      DateTime      @default(now())
  /** Xabarni yuborgan direktor. */
  submittedById  String
  reviewedAt     DateTime?
  /** Tasdiqlagan yoki rad etgan owner. */
  reviewedById   String?
  /** Rad etilgan bo'lsa — sababi. */
  reviewNote     String?

  organization Organization @relation(fields: [organizationId], references: [id])
  submittedBy  User         @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String?
  role           Role
  organizationId String?
  createdAt      DateTime @default(now())
  // Parol/rol o'zgarganda yoki hisob bloklanganda oshiriladi — JWT ichidagi
  // qiymat bilan mos kelmasa, requireRole sessiyani darhol bekor qiladi
  // (token muddati hali tugamagan bo'lsa ham).
  sessionVersion Int      @default(0)
  isActive       Boolean  @default(true)

  organization   Organization?   @relation(fields: [organizationId], references: [id])
  tutorOfGroups  Group[]         @relation("GroupTutor")
  studentProfile StudentProfile?
  attempts       Attempt[]
  paymentsSubmitted Payment[] @relation("PaymentSubmittedBy")
  paymentsReviewed  Payment[] @relation("PaymentReviewedBy")

  @@index([organizationId])
}

model Group {
  id             String @id @default(cuid())
  name           String
  tutorId        String
  organizationId String

  tutor        User             @relation("GroupTutor", fields: [tutorId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  students     StudentProfile[]
  attempts     Attempt[]

  @@index([organizationId])
  @@index([tutorId])
}

model StudentProfile {
  id      String @id @default(cuid())
  userId  String @unique
  groupId String

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Topic {
  id   String @id @default(cuid())
  name String

  questions Question[]
}

model Question {
  id      String @id @default(cuid())
  topicId String
  text    String
  // Variantlar ro'yxati (string[]). Soni qat'iy 4 ta emas — haqiqiy YHQ
  // savollarida 2 tadan 5 tagacha variant uchraydi. Chegara
  // `src/lib/questionOptions.ts` dagi MIN_OPTIONS/MAX_OPTIONS bilan
  // belgilanadi va `services/questions.ts` da tekshiriladi.
  options            Json
  correctOptionIndex Int
  imageUrl           String?
  imageAlt           String?
  explanation        String?
  // YHQ (Yo'l harakati qoidalari) hujjatidagi band raqami — izohning huquqiy
  // asosi. Masalan: "YHQ 21-bobi 128-bandiga asosan" yoki "YHQ 1-ilovasi 3.27".
  // Ustoz o'quvchi bilan "nega bu javob to'g'ri?" deb bahslashganda aynan shu
  // bandga ko'rsata oladi. Ixtiyoriy: barcha savolda ham havola bo'lavermaydi.
  legalReference String?

  topic   Topic           @relation(fields: [topicId], references: [id])
  answers AttemptAnswer[]

  @@index([topicId])
}

model Attempt {
  id          String      @id @default(cuid())
  studentId   String
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  score       Int?
  mode        AttemptMode @default(PRACTICE)
  groupId     String?
  // Boshlanishda tanlangan savollar ID'lari, tartibi bilan — shu orqali
  // finishAttempt "jami savollar soni"ni biladi (javobsiz qolganlar ham
  // hisobga olinishi uchun) va kelajakda urinishni davom ettirish mumkin.
  questionIds String[]    @default([])

  student User            @relation(fields: [studentId], references: [id])
  group   Group?          @relation(fields: [groupId], references: [id])
  answers AttemptAnswer[]

  @@index([studentId])
  @@index([groupId])
}

model AttemptAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  questionId          String
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  // Bitta urinishda bitta savolga faqat bitta javob — qayta bosilsa
  // (masalan "Orqaga" bilan qaytib) yangilanadi, takrorlanmaydi.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
