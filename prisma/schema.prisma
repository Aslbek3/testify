generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  DIRECTOR
  /**
   * Qabulxona xodimi — direktorning yordamchisi, o'rinbosari EMAS.
   * Mijoz bilan ishlaydi: o'quvchi qo'shadi, guruhga ko'chiradi,
   * bloklaydi, parolini tiklaydi va (kalit yoqilgan bo'lsa) chek
   * tasdiqlaydi. Pul sozlamalari, xodimlar va guruhlar — hech qachon.
   * To'liq matritsa: `docs/rollar.md`.
   */
  RECEPTION
  TUTOR
  STUDENT
}

enum Plan {
  START
  STANDARD
  PRO
}

enum OrganizationStatus {
  ACTIVE
  TRIAL
  EXPIRED
}

enum AttemptMode {
  PRACTICE
  EXAM
}

/**
 * Urinish qayerdan boshlangani — FAQAT yorliq va filtr uchun.
 * Qoidalarni (savollar soni, taymer, o'tish balli) avvalgidek `AttemptMode`
 * boshqaradi. Nega alohida: "Maraton" mashqning varianti, u yangi `mode`
 * bo'lsa `QUESTION_COUNT`, barcha `mode: "EXAM"` filtrlari va tayyorgarlik
 * hisobi qayta ko'rilishi kerak bo'lardi — bittasi unutilsa statistika
 * jimgina noto'g'ri bo'lib qolardi (`services/attempts.ts` dagi izohga qara).
 * `null` — eski urinishlar (bu maydon qo'shilishidan oldingi). Ular
 * ro'yxatlarda `mode` bo'yicha "Mashq" yoki "Imtihon" deb ko'rsatiladi.
 */
enum AttemptSource {
  PRACTICE
  MARATHON
  EXAM
  ASSIGNMENT
  /**
   * "Xatolarim" bo'limidan boshlangan takrorlash testi.
   */
  MISTAKES
}

model Organization {
  id                 String             @id @default(cuid())
  name               String
  city               String
  plan               Plan               @default(STANDARD)
  status             OrganizationStatus @default(TRIAL)
  createdAt          DateTime           @default(now())
  // Obuna qachongacha amal qiladi. `null` — muddat belgilanmagan
  // (masalan sinov davri yoki eski tashkilot): bunda faqat `status`
  // ishlaydi, avvalgidek.
  //
  // Nega kerak: ilgari tashkilot bir marta "Faol" qilingach ABADIY faol
  // qolardi — hech narsa o'z-o'zidan tugamasdi va kimdir kalendarga
  // qarab qo'lda o'chirishi kerak edi.
  subscriptionEndsAt DateTime?

  // ---- O'quvchi to'lovi (o'quvchi → avtomaktab) ----
  //
  // Yoqilgan vaqt. `null` — avtomaktab o'quvchi to'lovini tizim orqali
  // qabul qilmaydi va hech bir o'quvchi to'lov sababli bloklanmaydi.
  //
  // Nega shunchaki `Boolean` emas: yoqilgan KUN kerak. Funksiya yoqilganda
  // eski o'quvchilarning ko'pchiligi ro'yxatdan o'tganiga allaqachon
  // sinov muddatidan ko'p bo'lgan — sinov ularning `createdAt` idan
  // hisoblansa, yoqilgan zahoti hammasi birdaniga yopilib qolardi. Shu
  // sabab sinov `max(createdAt, studentPaymentsEnabledAt)` dan hisoblanadi.
  studentPaymentsEnabledAt DateTime?
  /**
   * O'quvchi pul o'tkazadigan karta — to'liq ko'rsatiladi (qabul qiluvchi karta).
   */
  paymentCardNumber        String?
  paymentCardHolder        String?
  /**
   * So'mda, butun son.
   */
  priceOneMonth            Int?
  priceSixMonths           Int?
  /**
   * Yangi o'quvchining bepul kunlari.
   */
  trialDays                Int       @default(7)

  // ---- Rol kalitlari (direktor sozlamalarida) ----
  //
  // To'rttadan ortiq kalit qo'shilmaydi — har bir kalit test matritsasini
  // ikki barobar kattalashtiradi (`docs/rollar.md`). Standart qiymatlar
  // shu hujjatdan olingan va ataylab shunday: qabulxona bor bo'lsa
  // darhol ishga tushadi, ustozga esa ma'muriy huquq faqat direktor
  // ongli ravishda yoqqanda beriladi.
  /**
   * Qabulxona chekni tasdiqlay/rad eta oladi va naqd to'lovni qayd etadi.
   */
  receptionHandlesPayments Boolean   @default(true)
  /**
   * Qabulxona o'quvchining progressi va urinishlarini ko'ra oladi (faqat ko'rish).
   */
  receptionSeesProgress    Boolean   @default(true)
  /**
   * Ustoz o'z guruhiga o'quvchi qo'sha oladi va uni bloklay/tiklay oladi.
   * Qabulxonasi yo'q kichik avtomaktab uchun. Guruhga KO'CHIRISH bunga
   * kirmaydi — u ustozga hech qachon berilmaydi (`canAssignStudentToGroup`).
   */
  tutorManagesStudents     Boolean   @default(false)
  /**
   * Ustoz o'z o'quvchisining parolini tiklay oladi.
   */
  tutorResetsPasswords     Boolean   @default(false)

  users           User[]
  groups          Group[]
  payments        Payment[]
  studentPayments StudentPayment[]
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/**
 * To'lov haqida xabar.
 * MVP'da to'lov tizimi bilan integratsiya yo'q: direktor to'lovni amalga
 * oshirgach uning raqamini shu yerga kiritadi, owner esa bank ko'chirmasi
 * bilan solishtirib tasdiqlaydi. Avtomatik to'lov keyinroq qo'shiladi —
 * o'shanda ham model o'zgarmaydi, faqat yozuvni direktor emas, to'lov
 * tizimining xabari yaratadi.
 */
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  /**
   * So'mda, butun son — tiyin ishlatilmaydi.
   */
  amount         Int
  /**
   * Necha oyga to'langan: 1, 6, 12 va h.k.
   */
  months         Int
  /**
   * Qaysi tarif uchun — tasdiqlanganda tashkilot tarifi shunga o'tadi.
   */
  plan           Plan
  status         PaymentStatus @default(PENDING)
  /**
   * Bank/to'lov tizimidagi tranzaksiya yoki kvitansiya raqami.
   */
  reference      String?
  note           String?
  createdAt      DateTime      @default(now())
  /**
   * Xabarni yuborgan direktor.
   */
  submittedById  String
  reviewedAt     DateTime?
  /**
   * Tasdiqlagan yoki rad etgan owner.
   */
  reviewedById   String?
  /**
   * Rad etilgan bo'lsa — sababi.
   */
  reviewNote     String?

  organization Organization @relation(fields: [organizationId], references: [id])
  submittedBy  User         @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([status])
}

enum StudentPaymentMethod {
  /**
   * Karta orqali, chek bilan — direktor tasdiqlaydi.
   */
  CARD
  /**
   * Avtomaktab kassasiga naqd — direktor chekisiz belgilaydi.
   */
  CASH
}

/**
 * O'quvchining avtomaktabga to'lovi.
 * `Payment` dan (avtomaktab → owner) ATAYLAB alohida: to'lovchi, oluvchi,
 * tasdiqlovchi va kirishga ta'siri boshqa. Bittaga birlashtirilsa, har
 * so'rovda "bu qaysi turdagi to'lov" deb tekshirib yurishga to'g'ri
 * kelardi va bittasini boshqasining ro'yxatiga aralashtirib yuborish oson
 * bo'lardi.
 */
model StudentPayment {
  id             String               @id @default(cuid())
  organizationId String
  studentId      String
  /**
   * So'mda — yuborilgan paytdagi narx (keyin narx o'zgarsa ham tarix buzilmaydi).
   */
  amount         Int
  /**
   * 1 yoki 6.
   */
  months         Int
  method         StudentPaymentMethod
  status         PaymentStatus        @default(PENDING)
  /**
   * Chek faylining saqlash kaliti (yo'l emas) — `lib/receiptStorage.ts`.
   * Naqd to'lovda `null`.
   */
  receiptKey     String?
  receiptMime    String?
  createdAt      DateTime             @default(now())
  reviewedAt     DateTime?
  /**
   * Tasdiqlagan/rad etgan yoki naqd to'lovni belgilagan direktor.
   */
  reviewedById   String?
  /**
   * Rad etilgan bo'lsa — sababi.
   */
  reviewNote     String?

  organization Organization @relation(fields: [organizationId], references: [id])
  student      User         @relation("StudentPaymentStudent", fields: [studentId], references: [id])
  reviewedBy   User?        @relation("StudentPaymentReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([studentId])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String?
  role           Role
  organizationId String?
  createdAt      DateTime @default(now())
  // Parol/rol o'zgarganda yoki hisob bloklanganda oshiriladi — JWT ichidagi
  // qiymat bilan mos kelmasa, requireRole sessiyani darhol bekor qiladi
  // (token muddati hali tugamagan bo'lsa ham).
  sessionVersion Int      @default(0)
  isActive       Boolean  @default(true)

  organization            Organization?    @relation(fields: [organizationId], references: [id])
  tutorOfGroups           Group[]          @relation("GroupTutor")
  studentProfile          StudentProfile?
  attempts                Attempt[]
  paymentsSubmitted       Payment[]        @relation("PaymentSubmittedBy")
  paymentsReviewed        Payment[]        @relation("PaymentReviewedBy")
  studentPayments         StudentPayment[] @relation("StudentPaymentStudent")
  studentPaymentsReviewed StudentPayment[] @relation("StudentPaymentReviewer")
  assignmentsCreated      Assignment[]     @relation("AssignmentCreatedBy")
  notifications           Notification[]

  @@index([organizationId])
}

enum NotificationType {
  /**
   * O'quvchiga: ustoz yangi vazifa berdi.
   */
  ASSIGNMENT_NEW
  /**
   * Direktorga: o'quvchi chek yubordi.
   */
  PAYMENT_SUBMITTED
  /**
   * O'quvchiga: to'lov tasdiqlandi (chek yoki naqd).
   */
  PAYMENT_CONFIRMED
  /**
   * O'quvchiga: chek rad etildi.
   */
  PAYMENT_REJECTED
}

/**
 * Sayt ichidagi bildirishnoma (menyudagi qo'ng'iroqcha).
 * Matn yaratilgan paytda TAYYOR holda saqlanadi, turi va ID'lardan har
 * safar qayta yig'ilmaydi: "12/10/2026 gacha to'landi" degan xabar keyin
 * muddat yana uzaytirilsa ham o'sha paytdagi faktni aytib turishi kerak.
 * `type` esa filtr va kelajakdagi kanallar (Telegram) uchun.
 * Muddat eslatmalari ("vazifa ertaga tugaydi") bu yerga YOZILMAYDI — ular
 * sahifa ochilganda hisoblanadi. Aks holda ularni o'z vaqtida yaratadigan
 * fon vazifasi (cron) kerak bo'lardi.
 */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /**
   * Bosilganda ochiladigan sahifa (ichki yo'l, masalan `/student`).
   */
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Group {
  id             String @id @default(cuid())
  name           String
  tutorId        String
  organizationId String

  tutor        User             @relation("GroupTutor", fields: [tutorId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  students     StudentProfile[]
  attempts     Attempt[]
  assignments  Assignment[]

  @@index([organizationId])
  @@index([tutorId])
}

enum AssignmentKind {
  /**
   * "Muddatgacha N ta imtihon" — muddat ichida yakunlangan ISTALGAN imtihon
   * sanaladi (vazifa tugmasidan boshlanmagan bo'lsa ham).
   */
  EXAM
  /**
   * "Shu mavzulardan N ta mashq" — faqat vazifa orqali boshlangan mashq
   * sanaladi (`Attempt.assignmentId`), chunki oddiy mashq mavzu tanlamaydi.
   */
  PRACTICE
}

/**
 * Ustozning guruhga bergan vazifasi.
 * Bajarilgani ATAYLAB saqlanmaydi (masalan `doneCount` ustuni yo'q) — u
 * har safar urinishlardan hisoblanadi (`services/assignments.ts`). Aks
 * holda bir fakt ikki joyda yashab, urinish yakunlanganda yoki muddati
 * o'tib avtomatik yopilganda sonni ham yangilash kerak bo'lardi va bittasi
 * unutilsa ikki panel boshqa-boshqa raqam ko'rsatardi.
 */
model Assignment {
  id          String         @id @default(cuid())
  groupId     String
  /**
   * Vazifani bergan ustoz. Guruh keyin boshqa ustozga berilsa ham tarix
   * uchun saqlanadi; boshqaruv huquqi esa guruhning HOZIRGI ustozida.
   */
  createdById String
  kind        AssignmentKind
  /**
   * Faqat PRACTICE uchun — qaysi mavzulardan. EXAM uchun bo'sh: imtihon
   * haqiqiy imtihon kabi butun bazadan tuziladi.
   */
  topicIds    String[]       @default([])
  /**
   * Necha marta bajarish kerak (imtihonlar yoki mashqlar soni).
   */
  targetCount Int
  /**
   * Muddat — tanlangan kunning oxiri, O'zbekiston vaqti bilan.
   */
  dueAt       DateTime
  note        String?
  createdAt   DateTime       @default(now())

  group     Group     @relation(fields: [groupId], references: [id])
  createdBy User      @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  attempts  Attempt[]

  @@index([groupId, dueAt])
}

model StudentProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  groupId   String
  // To'langan muddat qachongacha. `null` — hali hech qachon to'lamagan
  // (bunda faqat sinov muddati ishlaydi). Faqat tasdiqlangan to'lov
  // (karta yoki naqd) uzaytiradi — `services/studentPayments.ts`.
  paidUntil DateTime?

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Topic {
  id   String @id @default(cuid())
  name String

  questions Question[]
}

model Question {
  id                 String  @id @default(cuid())
  topicId            String
  text               String
  // Variantlar ro'yxati (string[]). Soni qat'iy 4 ta emas — haqiqiy YHQ
  // savollarida 2 tadan 5 tagacha variant uchraydi. Chegara
  // `src/lib/questionOptions.ts` dagi MIN_OPTIONS/MAX_OPTIONS bilan
  // belgilanadi va `services/questions.ts` da tekshiriladi.
  options            Json
  correctOptionIndex Int
  imageUrl           String?
  imageAlt           String?
  explanation        String?
  // YHQ (Yo'l harakati qoidalari) hujjatidagi band raqami — izohning huquqiy
  // asosi. Masalan: "YHQ 21-bobi 128-bandiga asosan" yoki "YHQ 1-ilovasi 3.27".
  // Ustoz o'quvchi bilan "nega bu javob to'g'ri?" deb bahslashganda aynan shu
  // bandga ko'rsata oladi. Ixtiyoriy: barcha savolda ham havola bo'lavermaydi.
  legalReference     String?

  topic   Topic           @relation(fields: [topicId], references: [id])
  answers AttemptAnswer[]

  @@index([topicId])
}

model Attempt {
  id           String         @id @default(cuid())
  studentId    String
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?
  score        Int?
  mode         AttemptMode    @default(PRACTICE)
  groupId      String?
  // Boshlanishda tanlangan savollar ID'lari, tartibi bilan — shu orqali
  // finishAttempt "jami savollar soni"ni biladi (javobsiz qolganlar ham
  // hisobga olinishi uchun) va kelajakda urinishni davom ettirish mumkin.
  questionIds  String[]       @default([])
  // Qayerdan boshlangani — yorliq va "Xatolarim" filtri uchun (yuqoridagi
  // `AttemptSource` izohiga qara). Qoidalar `mode` da qoladi.
  source       AttemptSource?
  // Vazifa tugmasi orqali boshlangan bo'lsa — qaysi vazifa. Vazifa
  // o'chirilsa urinish yo'qolmaydi, faqat bog'lanish uziladi: urinish
  // o'quvchining natijasi, vazifaniki emas.
  assignmentId String?

  student    User            @relation(fields: [studentId], references: [id])
  group      Group?          @relation(fields: [groupId], references: [id])
  assignment Assignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  answers    AttemptAnswer[]

  @@index([studentId])
  @@index([groupId])
  @@index([assignmentId])
}

model AttemptAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  questionId          String
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  // Bitta urinishda bitta savolga faqat bitta javob — qayta bosilsa
  // (masalan "Orqaga" bilan qaytib) yangilanadi, takrorlanmaydi.
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
